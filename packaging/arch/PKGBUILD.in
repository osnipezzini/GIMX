# Generated by scripts/build-arch-package.sh from a local source snapshot.
pkgname=gimx
pkgver=@VERSION@
pkgrel=3
pkgdesc='Use a computer as a hub for gaming devices'
arch=('x86_64')
url='https://github.com/osnipezzini/GIMX'
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'wxwidgets-gtk3' 'bluez-libs' 'libxml2'
         'libusb' 'ncurses' 'mhash' 'curl' 'libxi' 'libx11')
makedepends=('gettext')
optdepends=('avrdude: flashing USB adapter firmware')
conflicts=('gimx-git')
source=('gimx-src.tar.gz')
sha256sums=('@SHA256@')

prepare() {
  cd "$srcdir/gimx"
  # Keep the bundled helper without colliding with bluez-utils' bdaddr.
  sed -i 's/wxT("bdaddr /wxT("gimx-bdaddr /g' launcher/gimx-launcher.cpp
}

build() {
  cd "$srcdir/gimx"
  make
}

check() {
  cd "$srcdir/gimx"
  local _libpath
  _libpath=$(find "$PWD/shared" -name 'libgimx*.so' -printf '%h\n' | sort -u | paste -sd:)
  LD_LIBRARY_PATH="$_libpath" ./core/gimx --help >/dev/null
}

package() {
  cd "$srcdir/gimx"
  make -j1 DESTDIR="$pkgdir" install
  mv "$pkgdir/usr/bin/bdaddr" "$pkgdir/usr/bin/gimx-bdaddr"
  # Upstream sets setuid/setgid on the runtime and utilities. Do not grant
  # automatic root execution to device-facing programs in this package.
  chmod 0755 "$pkgdir/usr/bin/"*
  install -Dm644 README.md "$pkgdir/usr/share/doc/gimx/README.md"
}
